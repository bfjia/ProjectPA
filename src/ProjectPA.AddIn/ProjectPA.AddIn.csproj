<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Gac>C:\Windows\assembly</Gac>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectPA.UI\ProjectPA.UI.csproj" />
    <EmbeddedResource Include="Ribbon.xml" LogicalName="Ribbon.xml" />
    <Reference Include="Microsoft.CSharp" />
    <!-- Office interop from the GAC (installed with Office); types are embedded, nothing to ship -->
    <Reference Include="Microsoft.Office.Interop.Outlook" HintPath="$(Gac)\GAC_MSIL\Microsoft.Office.Interop.Outlook\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.Outlook.dll" EmbedInteropTypes="true" />
    <Reference Include="office" HintPath="$(Gac)\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\office.dll" EmbedInteropTypes="true" />
    <Reference Include="Extensibility" HintPath="$(Gac)\GAC\Extensibility\7.0.3300.0__b03f5f7f11d50a3a\Extensibility.dll" EmbedInteropTypes="true" />
  </ItemGroup>
</Project>
