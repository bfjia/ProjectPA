<Window x:Class="ProjectPA.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PApii settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6B6B6B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,4" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="16,4,16,16">
    <TextBlock Style="{StaticResource Head}" Text="Accounts" />
    <TextBlock Style="{StaticResource Note}" Text="Email from ticked accounts may be sent to Claude when you use a PApii button. Untick an account to keep its mail out." />
    <StackPanel x:Name="accounts" />

    <TextBlock Style="{StaticResource Head}" Text="Sign-off" />
    <TextBlock Style="{StaticResource Note}" Text="Leave blank for a closing line followed by your first name. Type none for no sign-off. Anything else is used exactly as written." />
    <TextBox x:Name="signOff" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Auto" />

    <TextBlock Style="{StaticResource Head}" Text="Keep saved sessions for (days)" />
    <TextBlock Style="{StaticResource Note}" Text="Each request saves the thread and its attachments in a session folder so you can ask follow-up questions. Older folders are deleted." />
    <TextBox x:Name="keepDays" Width="60" HorizontalAlignment="Left" />

    <TextBlock Style="{StaticResource Head}" Text="Claude Code executable" />
    <TextBlock x:Name="found" Style="{StaticResource Note}" />
    <TextBox x:Name="claudePath" />

    <DockPanel Margin="0,18,0,0">
      <Button DockPanel.Dock="Left" Content="Open data folder" Click="OpenData" Margin="0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Save" IsDefault="True" Click="Save" />
        <Button Content="Cancel" IsCancel="True" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
