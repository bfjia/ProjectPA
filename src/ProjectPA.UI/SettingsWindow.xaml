<Window x:Class="ProjectPA.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PApii settings" Width="520" SizeToContent="Height" MaxHeight="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6B6B6B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,4" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="Inline" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="16,12,16,16">
      <Button DockPanel.Dock="Left" Content="Open data folder" Click="OpenData" Margin="0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Save" IsDefault="True" Click="Save" />
        <Button Content="Cancel" IsCancel="True" />
      </StackPanel>
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,4,16,4">
        <TextBlock Style="{StaticResource Head}" Text="Accounts" />
        <TextBlock Style="{StaticResource Note}" Text="Email from ticked accounts may be sent to Claude when you use a PApii button. Untick an account to keep its mail out." />
        <StackPanel x:Name="accounts" />

        <TextBlock Style="{StaticResource Head}" Text="Sign-off" />
        <TextBlock Style="{StaticResource Note}" Text="Leave blank for a closing line followed by your first name. Type none for no sign-off. Anything else is used exactly as written." />
        <TextBox x:Name="signOff" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Auto" />

        <TextBlock Style="{StaticResource Head}" Text="Writing style" />
        <TextBlock Style="{StaticResource Note}" Text="Learn reads about 30 of your recent sent emails from that account, sends them to Claude once, and saves a short description of how you write. Drafts for that account then follow it. Edit opens the description so you can correct it." />
        <StackPanel x:Name="styles" />

        <TextBlock Style="{StaticResource Head}" Text="Calendars that count as busy" />
        <TextBlock Style="{StaticResource Note}" Text="Find Times treats you as busy whenever a ticked calendar has an entry that is not marked Free. Only the times are used, never what the entries say." />
        <StackPanel x:Name="calendars" />

        <TextBlock Style="{StaticResource Head}" Text="Working hours" />
        <TextBlock Style="{StaticResource Note}" Text="Find Times only suggests times inside these hours and on these days." />
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="workStart" Width="56" />
          <TextBlock Style="{StaticResource Inline}" Text="to" />
          <TextBox x:Name="workEnd" Width="56" />
        </StackPanel>
        <WrapPanel x:Name="workDays" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Style="{StaticResource Inline}" Margin="0,0,6,0" Text="Keep" />
          <TextBox x:Name="buffer" Width="40" />
          <TextBlock Style="{StaticResource Inline}" Text="minutes free around meetings, and look" />
          <TextBox x:Name="horizon" Width="40" />
          <TextBlock Style="{StaticResource Inline}" Text="days ahead." />
        </StackPanel>

        <TextBlock Style="{StaticResource Head}" Text="Keep saved sessions for (days)" />
        <TextBlock Style="{StaticResource Note}" Text="Each email you use PApii on gets a saved session: a copy of the thread and its attachments, kept so you can ask follow-up questions. Sessions older than this are removed each time Outlook starts. Saved Sessions on the PApii tab lists them and can delete them all at once." />
        <TextBox x:Name="keepDays" Width="60" HorizontalAlignment="Left" />

        <TextBlock Style="{StaticResource Head}" Text="Claude Code executable" />
        <TextBlock x:Name="found" Style="{StaticResource Note}" />
        <TextBox x:Name="claudePath" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
