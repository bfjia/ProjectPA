<Window x:Class="ProjectPA.UI.PromptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PApii prompts" Width="680" Height="640" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,4" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock TextWrapping="Wrap" Text="These are the instructions PApii gives Claude. Pick one, change the wording, and save. Your version is used from then on; Reset brings back the built-in text." />
      <ComboBox x:Name="pick" DisplayMemberPath="Title" SelectionChanged="Picked" Width="220" HorizontalAlignment="Left" Margin="0,12,0,0" />
      <TextBlock x:Name="about" TextWrapping="Wrap" Foreground="#6B6B6B" FontSize="11" Margin="0,6,0,8" />
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Left" Content="Reset to built-in" Click="Reset" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Save" Click="Save" />
        <Button Content="Close" IsCancel="True" Margin="8,0,0,0" />
      </StackPanel>
      <TextBlock x:Name="state" VerticalAlignment="Center" Margin="12,0" Foreground="#6B6B6B" FontSize="11" />
    </DockPanel>

    <TextBox x:Name="text" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="12.5" Padding="6" />
  </DockPanel>
</Window>
